{
  "name": "nextcloud-talk-api",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Actions for the Nextcloud Talk API",
  "main": "dist/send-message/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src",
    "bundle": "ncc build src/commands/send-message/index.ts -o dist/send-message --target es2022",
    "bundle:check": "npm run bundle && git diff --exit-code -- dist"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/http-client": "^2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.14.1",
    "@types/node": "^24.7.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^10.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.8"
  }
}
